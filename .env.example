FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# LLM: any OpenAI-compatible endpoint (default Fireworks)
FIREWORKS_API_KEY=
LORE_LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LORE_AGENT_MODEL=accounts/fireworks/models/minimax-m3
LORE_FAST_MODEL=accounts/fireworks/models/glm-5p3-flash
LORE_DATAGEN_MODEL=accounts/fireworks/models/glm-5p3-flash
LORE_EMBED_MODEL=accounts/fireworks/models/qwen3-embedding-8b
LORE_EMBED_DIMS=1024

# Agent sandbox + GitHub (the agent clones, tests, pushes and opens PRs from inside E2B)
E2B_API_KEY=
# Fine-grained token scoped to the demo repo only: Contents + Pull requests read/write
GITHUB_TOKEN=

# Slack bot (Socket Mode) — create the app from slack-app-manifest.yml
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
LORE_SLACK_TENANT=northwind
LORE_SLACK_INCIDENT_CHANNEL=incidents
LORE_WEB_URL=http://localhost:3000

# Monitoring -> incidents. Webhook URL: https://<public-host>/api/webhooks/<sentry|grafana|alertmanager|datadog|generic>?token=<LORE_WEBHOOK_TOKEN>
LORE_WEBHOOK_TOKEN=
# Only needed for `uv run lore sentry-error` (sends a real test error)
SENTRY_DSN=
